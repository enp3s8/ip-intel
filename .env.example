# Скопируйте этот файл в .env и заполните нужные ключи.
# Все ключи ОПЦИОНАЛЬНЫ — скрипт работает и без них (бесплатные API + локальные .mmdb).

# Shodan (без ключа используется бесплатный Shodan InternetDB: порты, CPE, CVE, теги)
# С ключом запрашивается полный Shodan Host API (баннеры, сервисы, ISP, ОС)
SHODAN_API_KEY=

# ipinfo.io (без токена работает с лимитом запросов, с токеном лимит выше + больше полей)
IPINFO_TOKEN=

# 2ip.io (без токена работает бесплатный эндпоинт + api.2ip.me/provider.json)
TWOIP_TOKEN=

# MaxMind Web Services (бесплатный GeoLite2 или платный GeoIP2)
# Получить бесплатно: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# geolite (бесплатный geolite.info) или paid (платный geoip.maxmind.com)
MAXMIND_ENDPOINT=geolite

# Дополнительные пути к локальным .mmdb базам (через двоеточие, например GeoLite2-City.mmdb)
MAXMIND_MMDB_PATHS=
